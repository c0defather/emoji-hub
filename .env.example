# Neon / Vercel Postgres
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Vercel AI Gateway — https://vercel.com/[team]/~/ai-gateway/api-keys
# Not needed when deployed on Vercel with OIDC enabled.
AI_GATEWAY_API_KEY=

# Model used to write descriptions and generational meanings.
EMOJI_ENRICHMENT_MODEL=google/gemini-3.7-flash
EMOJI_ENRICHMENT_BATCH_SIZE=8
EMOJI_ENRICHMENT_CONCURRENCY=3
EMOJI_ENRICHMENT_MAX_ATTEMPTS=3

# Shared secret for /api/cron/*. Vercel Cron sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=
